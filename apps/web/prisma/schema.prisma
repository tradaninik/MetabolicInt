// Prisma schema for Metabolic Intelligence.
// Provider is sqlite for zero-setup local dev; switch to postgresql or a libSQL
// driver for deploy (schema is portable — see docs/DEPLOY.md).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Reference food catalog (seeded from @mi/food-db).
model Food {
  id            String   @id
  name          String
  aliases       String?  // JSON-encoded string[]
  region        String   // CuisineRegion
  category      String   // FoodCategory
  servingGrams  Float
  katoriGrams   Float?
  createdByUserId String?  // null = catalog food; set = user-created
  kcalPer100g   Float
  carbsPer100g  Float
  proteinPer100g Float
  fatPer100g    Float
  fiberPer100g  Float
  gi            Float    // glycemic index 0-100
  createdAt     DateTime @default(now())

  entries      FoodEntry[]

  @@index([region])
  @@index([name])
}

/// App user. role = member | caregiver | doctor.
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String?
  name             String?
  image            String?
  role             String   @default("member")
  emailVerified    DateTime?

  // Onboarding profile
  onboardingComplete Boolean @default(false)
  age               Int?
  gender            String?
  ethnicity         String?
  country           String?
  region            String?  // cuisine region
  heightCm          Float?
  weightKg          Float?
  waistCm           Float?
  bodyFatPct        Float?
  hba1c             Float?
  fastingGlucose    Float?
  systolicBp        Int?
  diastolicBp       Int?
  totalCholesterol  Float?
  sleepHours        Float?
  activityLevel     String?
  occupation        String?
  smoking           String?
  alcohol           String?
  conditions        String?  // JSON
  medications       String?  // JSON
  familyHistory     String?  // JSON
  goals             String?  // JSON

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  foodEntries       FoodEntry[]
  glucoseReadings   GlucoseReading[]
  activityEntries   ActivityEntry[]
  sleepEntries      SleepEntry[]
  weightEntries     WeightEntry[]
  bpEntries         BloodPressureEntry[]
  learnedModel      UserLearnedModel?
  savedCombos      SavedCombo[]
  settings         UserSettings?
  labs             Lab[]
  recipes          Recipe[]
  meds      Medication[]
  dayTags          DayContextTag[]
  insights          InsightCard[]
  coachThreads      CoachThread[]

  // Care relationships
  careGiven         CareRelationship[] @relation("Caregiver")
  careReceived      CareRelationship[] @relation("Ward")

  // Doctor links
  doctorPatients    DoctorPatientLink[] @relation("Doctor")
  patientDoctors    DoctorPatientLink[] @relation("Patient")

  achievements      Achievement[]
  prakritiProfiles  PrakritiProfile[]
}

model UserLearnedModel {
  id                       String   @id @default(cuid())
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   String   @unique
  sensitivityMgDlPerGCarb  Float
  sampleSize               Int
  isPrior                  Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model FoodEntry {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  food         Food     @relation(fields: [foodId], references: [id])
  foodId       String
  portionType  String   // katori | serving | grams
  portionValue Float
  grams        Float
  kcal         Float
  carbsG       Float
  proteinG     Float
  fatG         Float
  photoPath    String?
  notes        String?
  loggedAt     DateTime @default(now())

  @@index([userId, loggedAt])
}

model GlucoseReading {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  value     Float    // mg/dL
  source    String   @default("manual") // manual | cgm
  takenAt   DateTime @default(now())

  @@index([userId, takenAt])
}

model ActivityEntry {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  type        String   // walk | yoga | strength | ...
  durationMin Float
  source      String   @default("manual") // manual | apple_health | google_fit | ...
  at          DateTime @default(now())

  @@index([userId, at])
}

model SleepEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  hours     Float
  wokeAt    DateTime @default(now())

  @@index([userId, wokeAt])
}

model WeightEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kg        Float
  takenAt   DateTime @default(now())

  @@index([userId, takenAt])
}

model BloodPressureEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  systolic  Int
  diastolic Int
  takenAt   DateTime @default(now())

  @@index([userId, takenAt])
}

model InsightCard {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  type       String
  title      String
  body       String
  effectPct  Float
  confidence Float
  evidence   String   // JSON
  dismissed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, dismissed])
}

model CoachThread {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String?
  messages  CoachMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachMessage {
  id        String   @id @default(cuid())
  thread    CoachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  role      String   // user | coach
  content   String
  citations String?  // JSON
  grounded  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([threadId])
}

/// Family monitoring: caregiver watches a ward.
model CareRelationship {
  id              String   @id @default(cuid())
  caregiver       User     @relation("Caregiver", fields: [caregiverId], references: [id], onDelete: Cascade)
  caregiverId     String
  ward            User     @relation("Ward", fields: [wardId], references: [id], onDelete: Cascade)
  wardId          String
  relation        String?  // parent | spouse | child | ...
  alertGlucoseHigh Boolean @default(true)
  alertGlucoseLow  Boolean @default(true)
  alertMissedMeds  Boolean @default(false)
  createdAt       DateTime @default(now())

  @@unique([caregiverId, wardId])
}

model DoctorPatientLink {
  id              String   @id @default(cuid())
  doctor          User     @relation("Doctor", fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId        String
  patient         User     @relation("Patient", fields: [patientId], references: [id], onDelete: Cascade)
  patientId       String
  adherenceScore  Float?
  riskFlags       String?  // JSON
  createdAt       DateTime @default(now())

  @@unique([doctorId, patientId])
}

model Achievement {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // streak | badge | challenge
  key       String   // e.g. '7_day_logging_streak'
  value     Float?
  unlockedAt DateTime @default(now())

  @@unique([userId, type, key])
}

/// User-created combo meals (one tap re-log of a saved plate).
model SavedCombo {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  items     String   // JSON [{foodId, portionType, portionValue}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
/// Phase 2c: display-unit + target-range settings. Null target columns = still on
/// educational defaults (app-side); a doctor's targets always take precedence.
model UserSettings {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String   @unique
  glucoseUnit        String   @default("mg/dL") // 'mg/dL' | 'mmol/L'
  tFastingLow        Float?
  tFastingHigh       Float?
  tPremealLow        Float?
  tPremealHigh       Float?
  tPostprandialLow   Float?
  tPostprandialHigh  Float?
  tBedtimeLow        Float?
  tBedtimeHigh       Float?
  updatedAt          DateTime @updatedAt
}

/// Phase 2c: lab results. HbA1c first; a1cPercent is canonical regardless of entry unit.
model Lab {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  testType    String   // 'hba1c' (extensible)
  value       Float
  unit        String   // '%' | 'mmol/mol'
  a1cPercent  Float
  performedAt String   // YYYY-MM-DD
  labName     String?
  createdAt   DateTime @default(now())

  @@index([userId, testType, performedAt])
}

/// P6-a: user recipes - named multi-ingredient meals with per-serving nutrition
/// computed at read time (never stored). items JSON shape mirrors SavedCombo:
/// [{foodId, portionType, portionValue}]. Logging expands into one FoodEntry per
/// ingredient (frozen numbers, same /api/meals path); no reference lock needed.
/// (P6-d/P6-f add LabPanel/LabResult/ReportDocument on top of this schema;
/// the wave lands as ONE additive migration 0005 - see that commit.)
model Recipe {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  servings  Float
  items     String   // JSON [{foodId, portionType, portionValue}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Phase 2c: medications — adherence display only.
/// Deliberately NO dose/strength/notes fields anywhere (safety posture, blueprint §8).
model Medication {
  id            String          @id @default(cuid())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  name          String
  scheduleTimes String          // JSON array of "HH:MM"
  isActive      Boolean         @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime        @default(now())
  logs          MedicationLog[]

  @@index([userId])
}

/// Phase 2c: per-slot taken/skipped records. 'Skipped' stays scheduled-but-untaken;
/// undo deletes the row.
model MedicationLog {
  id           String     @id @default(cuid())
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  medicationId String
  userId       String     // denormalized for owner-scoped queries (pattern: Food.createdByUserId)
  logDate      String     // YYYY-MM-DD
  slotTime     String     // HH:MM
  status       String     // 'taken' | 'skipped'
  createdAt    DateTime   @default(now())

  @@unique([medicationId, logDate, slotTime])
  @@index([userId, logDate])
}

/// Phase 2c: day-context tags — associations from the user's notes, never causes.
model DayContextTag {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tagDate   String   // YYYY-MM-DD
  tag       String   // enum enforced app-side
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, tagDate, tag])
  @@index([userId, tagDate])
}
model PrakritiProfile {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  answersJson    String   // JSON: { questionId: doshaTag }
  vataScore      Int
  pittaScore     Int
  kaphaScore     Int
  primaryDosha   String
  secondaryDosha String
  takenAt        DateTime @default(now())

  @@index([userId, takenAt])
}
